*.min.js
*.min.css

# Binärdateien & Dokumente
*.docx
*.pdf
*.png
*.jpg
*.svg

# Generierte Reports (werden von GitHub Actions committed)
security/reports/

# Testberichte
tests/report.html
tests/.pytest_cache/

